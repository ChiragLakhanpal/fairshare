# Copy to .env. Nothing here is committed.

# Data backend: duckdb (local, offline) or databricks
FAIRSHARE_BACKEND=duckdb
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_SERVER_HOSTNAME=<workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
DATABRICKS_TOKEN=dapi...            # your own PAT: Genie is free when called as a user, billed as a service principal
GENIE_SPACE_ID=                     # the Genie Agent (space) over aa_demo.gold.sales_metrics
GENIE_SPACE_URL=
DASHBOARD_ID=
DASHBOARD_URL=
DATABRICKS_APP_URL=
JOB_URL=                            # the nightly job (databricks bundle summary prints it)

# Model: azure (Foundry deployment), databricks (serving endpoint), openai, or none
FAIRSHARE_MODEL=none
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview
DATABRICKS_MODEL=databricks-gpt-5-mini
FOUNDRY_PROJECT_URL=

# Traces (OpenTelemetry -> MLflow). Leave empty for none.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=         # Databricks: Authorization=Bearer%20<PAT>,X-Databricks-UC-Table-Name=aa_demo.ops.traces
MLFLOW_TRACES_URL=

REPO_URL=

# Delegate: the writers' backend when it should differ from the chat loop's (azure for gpt-5-mini; empty = FAIRSHARE_MODEL)
FAIRSHARE_THINKER=
# Foundry agents (lakehouse/foundry.py): the project endpoint, and the content filter policy's full resource id as the guardrail
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_RAI_POLICY=
# Prospect research sources: cached (data/research, the default) or brave (Brave Search API with SEARCH_API_KEY)
FAIRSHARE_SEARCH=cached
SEARCH_API_KEY=
