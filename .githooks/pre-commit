#!/bin/sh
# The gate: ground-truth SQL must run and the local checks must pass before a commit.
# With FAIRSHARE_FULL_GATE=1 and Databricks + Genie configured, the Genie benchmark runs too (slower, needs network).
set -e
cd "$(git rev-parse --show-toplevel)"
PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
echo "pre-commit: ground-truth SQL"
FAIRSHARE_BACKEND=duckdb FAIRSHARE_TRACES= $PY evals/run_benchmark.py --check > /dev/null
echo "pre-commit: tests"
FAIRSHARE_BACKEND=duckdb FAIRSHARE_TRACES= $PY -m pytest evals -q
if [ "$FAIRSHARE_FULL_GATE" = "1" ] && [ -n "$GENIE_SPACE_ID" ]; then
  echo "pre-commit: Genie benchmark"
  FAIRSHARE_BACKEND=databricks $PY evals/run_benchmark.py --genie --label "pre-commit $(git rev-parse --abbrev-ref HEAD)"
fi
